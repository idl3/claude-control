{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tab-bar",
  "description": "Permissions for the shell's local tab-bar webview (tabs.html).",
  "windows": ["main"],
  "webviews": ["tab-bar"],
  "permissions": [
    "core:default",
    "allow-browser-tabs",
    "allow-open-url",
    "core:window:allow-start-dragging"
  ]
}
